# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Anthropic (required) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override; defaults are set per-agent in code.
CLAUDE_MODEL=

# --- SERP data (required for serpAnalysisAgent) ---
SERPAPI_API_KEY=
SERP_API_BASE=
SERP_MAX_RESULTS=10
SERP_CACHE_TTL_HOURS=24
SERP_REQUEST_TIMEOUT_MS=15000

# --- Queue (required for the worker pipeline) ---
# Any Redis instance; BullMQ backs the job queue.
REDIS_URL=redis://localhost:6379
QUEUE_WORKER_CONCURRENCY=2

# --- Crawl inputs ---
# Newline-delimited absolute URLs. See urls.example.txt.
URL_LIST_PATH=./urls.txt
SCRAPE_OUTPUT_DIR=./output/scraped
SCRAPED_DATA_PATH=
SCRAPED_DATA_JSON=
PDP_METRICS_PATH=

# --- Politeness / rate limiting ---
# Concurrency ceilings per outbound dependency.
ENFORCE_ROBOTS=true
LIMIT_CLAUDE=2
LIMIT_HTTP=5
LIMIT_SERP=1

# --- Prompting ---
EXTRA_PROMPT=
